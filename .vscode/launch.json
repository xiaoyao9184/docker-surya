{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debugpy: label_wsgi test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/label",
            "args": [
                "${workspaceFolder}/label/test_api.py"
            ],
            "env": {
                // fix '_pytest.scope' nidule miss
                "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
                "HF_HUB_OFFLINE": "true",
                "XDG_CACHE_HOME": "${workspaceFolder}/cache",
                "DETECTOR_MODEL_CHECKPOINT": "${workspaceFolder}/cache/datalab/models/text_detection/2025_05_07",
                "DOCKER_HF_CACHE_PATH": "${workspaceFolder}/cache/huggingface",
                // NOT work Still downloading the main version from HF, so switch use model path
                // "VLLM_EXTRA_ARGS": "--revision 3b3d4cd --tokenizer-revision 3b3d4cd --code-revision 3b3d4cd",
                "SURYA_MODEL_CHECKPOINT": "/root/.cache/huggingface/hub/models--datalab-to--surya-ocr-2/snapshots/3b3d4cdf88d6928b0acdc75181b13206ea67c4a3",
                "SURYA_GGUF_LOCAL_MODEL_PATH": "${workspaceFolder}/cache/huggingface/hub/models--datalab-to--surya-ocr-2-gguf/snapshots/6a3a4c30e5e74446d4f8b6afd05b2f2da970f470/surya-2.gguf",
                "SURYA_GGUF_LOCAL_MMPROJ_PATH": "${workspaceFolder}/cache/huggingface/hub/models--datalab-to--surya-ocr-2-gguf/snapshots/6a3a4c30e5e74446d4f8b6afd05b2f2da970f470/surya-2-mmproj.gguf",
            },
            "justMyCode": false
        },

        {
            "name": "debugpy: gradio_app server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gradio/gradio_bin.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "${workspaceFolder}/gradio/gradio_app.py"
            ],
            "env": {
                "APP_PATH": "${workspaceFolder}/surya",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1",
                "HF_HUB_OFFLINE": "true",
                "XDG_CACHE_HOME": "${workspaceFolder}/cache",
                "DETECTOR_MODEL_CHECKPOINT": "${workspaceFolder}/cache/datalab/models/text_detection/2025_05_07",
                "OCR_ERROR_MODEL_CHECKPOINT": "${workspaceFolder}/cache/datalab/models/ocr_error_detection/2025_02_18",
                "FAST_LAYOUT_MODEL_CHECKPOINT": "${workspaceFolder}/cache/datalab/models/surya_layout2/0aee81d",
                "FAST_ORDER_MODEL_CHECKPOINT": "${workspaceFolder}/cache/datalab/models/surya_layout2/0aee81d/order",
                "DOCKER_HF_CACHE_PATH": "${workspaceFolder}/cache/huggingface",
                // NOT work Still downloading the main version from HF, so switch use model path
                // "VLLM_EXTRA_ARGS": "--revision 3b3d4cd --tokenizer-revision 3b3d4cd --code-revision 3b3d4cd",
                "SURYA_MODEL_CHECKPOINT": "/root/.cache/huggingface/hub/models--datalab-to--surya-ocr-2/snapshots/3b3d4cdf88d6928b0acdc75181b13206ea67c4a3",
                "SURYA_GGUF_LOCAL_MODEL_PATH": "${workspaceFolder}/cache/huggingface/hub/models--datalab-to--surya-ocr-2-gguf/snapshots/6a3a4c30e5e74446d4f8b6afd05b2f2da970f470/surya-2.gguf",
                "SURYA_GGUF_LOCAL_MMPROJ_PATH": "${workspaceFolder}/cache/huggingface/hub/models--datalab-to--surya-ocr-2-gguf/snapshots/6a3a4c30e5e74446d4f8b6afd05b2f2da970f470/surya-2-mmproj.gguf",
                "SURYA_INFERENCE_BACKEND": "${input:surya-inference-backend}",
                "LLAMA_CPP_BINARY": "${input:llama-cpp-binary}"
            },
            "justMyCode": false
        },

        {
            "name": "debugpy: surya.detection server",
            "type": "debugpy",
            "request": "launch",
            "module": "surya.detection.server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/surya",
            "args": [
                "--host",
                "127.0.0.1",
                "--port",
                "8001",
                "--checkpoint",
                "${workspaceFolder}/cache/datalab/models/text_detection/2025_05_07"
            ],
            "env": {
                "XDG_CACHE_HOME": "${workspaceFolder}/cache",
                "HF_HUB_OFFLINE": "true",
                "DETECTOR_MODEL_CHECKPOINT": "${workspaceFolder}/cache/datalab/models/text_detection/2025_05_07",
            },
            "justMyCode": false
        },
        {
            "name": "debugpy: surya.fast_layout server",
