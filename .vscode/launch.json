    "inputs": [
        {
            "id": "surya-inference-backend",
            "type": "pickString",
            "description": "Select the SURYA_INFERENCE_BACKEND(empty is auto)",
            "default": "",
            "options": [
                "",
                "vllm",
                "llamacpp",
            ]
        },
        {
            "id": "llama-cpp-binary",
            "type": "promptString",
            "description": "Enter the LLAMA_CPP_BINARY path",
            "default": "/usr/local/bin/llama-server"
