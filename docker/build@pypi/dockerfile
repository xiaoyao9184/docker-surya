ARG GITHUB_PROXY=
ARG SURYA_VERSION=0.20.0
ARG STREAMLIT_VERSION=1.57.0
ARG GRADIO_VERSION=5.8.0


FROM pytorch/pytorch:2.12.0-cuda12.6-cudnn9-runtime

ARG GITHUB_PROXY
ARG SURYA_VERSION
ARG STREAMLIT_VERSION
ARG GRADIO_VERSION
ARG LLAMA_CPP_CPU_URL=https://github.com/ggml-org/llama.cpp/releases/download/b10107/llama-b10107-bin-ubuntu-x64.tar.gz
ARG LLAMA_CPP_CUDA_URL=https://github.com/ai-dock/llama.cpp-cuda/releases/download/b10107/llama.cpp-b10107-cuda-12.8-amd64.tar.gz

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3-venv \
    libgl1 \
    libsm6 \
    libxext6 \
    libglib2.0-0 \
    libgomp1 \
    libxrender-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/llama.cpp/cpu /opt/llama.cpp/cuda /tmp/llama.cpp/cpu /tmp/llama.cpp/cuda \
    && curl -L "${GITHUB_PROXY}${LLAMA_CPP_CPU_URL}" -o /tmp/llama.cpp/cpu.tar.gz \
    && tar -xzf /tmp/llama.cpp/cpu.tar.gz -C /tmp/llama.cpp/cpu \
    && llama_server="$(find /tmp/llama.cpp/cpu -type f -name llama-server -print -quit)" \
    && test -n "${llama_server}" \
    && cp -a "$(dirname "${llama_server}")"/. /opt/llama.cpp/cpu/ \
    && chmod +x /opt/llama.cpp/cpu/llama-server \
    && curl -L "${GITHUB_PROXY}${LLAMA_CPP_CUDA_URL}" -o /tmp/llama.cpp/cuda.tar.gz \
    && tar -xzf /tmp/llama.cpp/cuda.tar.gz -C /tmp/llama.cpp/cuda \
    && llama_server="$(find /tmp/llama.cpp/cuda -type f -name llama-server -print -quit)" \
    && test -n "${llama_server}" \
    && cp -a "$(dirname "${llama_server}")"/. /opt/llama.cpp/cuda/ \
    && chmod +x /opt/llama.cpp/cuda/llama-server \
    && rm -rf /tmp/llama.cpp

RUN find /usr/local/lib /usr/lib \
        \( -path '*/site-packages/nvidia/*/lib' -o -path '*/dist-packages/nvidia/*/lib' \) \
        -type d -print 2>/dev/null \
        > /etc/ld.so.conf.d/llama-cuda.conf \
    && printf '%s\n' /usr/local/cuda/lib64 /usr/local/cuda/compat \
        >> /etc/ld.so.conf.d/llama-cuda.conf \
    && ldconfig

RUN printf '%s\n' \
    '#!/usr/bin/env sh' \
    'set -eu' \
    'if [ "${LLAMA_CPP_FORCE_CPU:-}" = "1" ]; then' \
    '    LLAMA_CPP_HOME=/opt/llama.cpp/cpu' \
    'elif { command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; } || [ -e /dev/nvidia0 ] || [ -e /dev/nvidiactl ]; then' \
    '    LLAMA_CPP_HOME=/opt/llama.cpp/cuda' \
    'else' \
    '    LLAMA_CPP_HOME=/opt/llama.cpp/cpu' \
    'fi' \
    'CUDA_LIBRARY_PATHS="$(find /usr/local/lib /usr/lib \( -path '"'"'*/site-packages/nvidia/*/lib'"'"' -o -path '"'"'*/dist-packages/nvidia/*/lib'"'"' \) -type d -print 2>/dev/null | paste -sd: -)"' \
    'export LD_LIBRARY_PATH="${LLAMA_CPP_HOME}:${CUDA_LIBRARY_PATHS}:/usr/local/cuda/lib64:/usr/local/cuda/compat${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"' \
    'exec "${LLAMA_CPP_HOME}/llama-server" "$@"' \
    > /usr/local/bin/llama-server \
    && chmod +x /usr/local/bin/llama-server

RUN python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/python -m pip install --upgrade pip

RUN /opt/venv/bin/python -m pip install --no-cache-dir \
    surya-ocr==${SURYA_VERSION}

# Lock streamlit version
RUN /opt/venv/bin/python -m pip install --no-cache-dir \
    streamlit==${STREAMLIT_VERSION} \
    pdftext==0.6.3

# Lock gradio version
RUN /opt/venv/bin/python -m pip install --no-cache-dir \
    gradio==${GRADIO_VERSION}

# Lock label-studio version
RUN /opt/venv/bin/python -m pip install --no-cache-dir \
    Flask==3.1.3 \
    colorama==0.4.6 \
    requests==2.34.2 \
    semver==3.0.4 \
    label-studio-sdk==1.0.10 \
    gunicorn==22.0.0 \
    boto3==1.35.91

# No-deps label-studio version
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps \
    git+${GITHUB_PROXY}https://github.com/HumanSignal/label-studio-ml-backend.git@b06ebeb#egg=label-studio-ml

# Override incorrect version
RUN /opt/venv/bin/python -m pip install --no-cache-dir \
    pydantic==2.10.5

COPY ./gradio /workspace/gradio
COPY ./label /workspace/label

EXPOSE 8501
EXPOSE 7860
EXPOSE 9090

VOLUME /root/.cache
VOLUME /workspace/label/.pytest_cache
# VOLUME /workspace/label/cache.db

ENV APP_PATH=/app
ENV PATH="/opt/venv/bin:${PATH}"
ENV GRADIO_SERVER_NAME="0.0.0.0"
ENV LABEL_STUDIO_URL=http://label-studio:8080

CMD ["surya_gui"]
